diff --git a/main/audio/engines/audio_level_meter.h b/main/audio/engines/audio_level_meter.h
new file mode 100644
index 0000000..66e3579
--- /dev/null
+++ b/main/audio/engines/audio_level_meter.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+// Aggregate levels only; never retain audio samples. Each meter has one task owner.
+class AudioLevelMeter {
+public:
+    void Add(const int16_t* data, size_t samples, size_t stride = 1, size_t channel = 0) {
+        if (data == nullptr || stride == 0 || channel >= stride) {
+            return;
+        }
+        for (size_t i = channel; i < samples; i += stride) {
+            const int32_t value = data[i];
+            const uint32_t magnitude = value < 0 ? -value : value;
+            sum_squares_ += static_cast<uint64_t>(value * value);
+            if (magnitude > peak_) {
+                peak_ = magnitude;
+            }
+            if (value == INT16_MIN || value == INT16_MAX) {
+                ++rail_samples_;
+            }
+            ++samples_;
+        }
+    }
+
+    float Rms() const {
+        return samples_ == 0 ? 0.0f : std::sqrt(static_cast<float>(sum_squares_) / samples_);
+    }
+    uint32_t Peak() const { return peak_; }
+    uint32_t RailSamples() const { return rail_samples_; }
+    uint32_t Samples() const { return samples_; }
+    void Reset() { *this = {}; }
+
+private:
+    uint64_t sum_squares_ = 0;
+    uint32_t samples_ = 0;
+    uint32_t peak_ = 0;
+    uint32_t rail_samples_ = 0;
+};
