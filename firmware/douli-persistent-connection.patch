new file mode 100644
index 0000000..6d22297
--- /dev/null
+++ b/main/backend_selection.cc
@@ -0,0 +1,264 @@
+#include "backend_selection.h"
+
+#include <nvs.h>
+#include <algorithm>
+#include <charconv>
+#include <cstring>
+#include <memory>
+
+namespace {
+using Json = std::unique_ptr<cJSON, decltype(&cJSON_Delete)>;
+Json ParseJson(const std::string& value) { return Json(cJSON_Parse(value.c_str()), cJSON_Delete); }
+std::string Text(const cJSON* value, const char* key) {
+    const auto item = cJSON_GetObjectItemCaseSensitive(value, key);
+    return cJSON_IsString(item) ? item->valuestring : "";
+}
+std::string Dump(const cJSON* value) {
+    char* text = cJSON_PrintUnformatted(value);
+    if (!text)
+        return "";
+    std::string result(text);
+    cJSON_free(text);
+    return result;
+}
+bool Id(const std::string& value) {
+    return value.size() == 36 && value.find_first_not_of("abcdef0123456789-") == std::string::npos;
+}
+bool Number(const std::string& text, int& value) {
+    auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+    return !text.empty() && error == std::errc() && end == text.data() + text.size();
+}
+bool PrivateIp(const std::string& host) {
+    int octets[4];
+    size_t start = 0;
+    for (int i = 0; i < 4; ++i) {
+        const auto end = host.find('.', start);
+        if ((i < 3) != (end != std::string::npos) ||
+            !Number(host.substr(start, end == std::string::npos ? end : end - start), octets[i]) ||
+            octets[i] < 0 || octets[i] > 255)
+            return false;
+        start = end + 1;
+    }
+    return octets[0] == 10 || octets[0] == 127 || (octets[0] == 192 && octets[1] == 168) ||
+           (octets[0] == 172 && octets[1] >= 16 && octets[1] <= 31);
+}
+bool Url(const std::string& url) {
+    const bool tls = url.starts_with("wss://");
+    if ((!tls && !url.starts_with("ws://")) || url.size() > 160)
+        return false;
+    const size_t start = tls ? 6 : 5;
+    const auto slash = url.find('/', start);
+    if (slash == std::string::npos || url.substr(slash) != "/xiaozhi/v1/")
+        return false;
+    const auto authority = url.substr(start, slash - start);
+    const auto colon = authority.find(':');
+    const auto host = authority.substr(0, colon);
+    if (host.empty() || host.find_first_not_of(
+                            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-") !=
+                            std::string::npos)
+        return false;
+    if (colon != std::string::npos) {
+        int port = 0;
+        if (!Number(authority.substr(colon + 1), port) || port < 1 || port > 65535)
+            return false;
+    }
+    return tls || host.ends_with(".local") || PrivateIp(host);
+}
+}  // namespace
+
+BackendSelection& BackendSelection::GetInstance() {
+    static BackendSelection instance;
+    return instance;
+}
+
+BackendSelection::BackendSelection() {
+    nvs_handle_t handle;
+    if (nvs_open("douli_route", NVS_READONLY, &handle) != ESP_OK)
+        return;
+    size_t size = 0;
+    std::string saved;
+    if (nvs_get_str(handle, "state", nullptr, &size) == ESP_OK && size <= 4096) {
+        saved.resize(size);
+        if (nvs_get_str(handle, "state", saved.data(), &size) != ESP_OK)
+            saved.clear();
+    }
+    nvs_close(handle);
+    const auto root = ParseJson(saved);
+    const auto committed = ParseJson(Text(root.get(), "plan"));
+    const auto trial = ParseJson(Text(root.get(), "trial"));
+    Parse(committed.get(), committed_);
+    Plan interrupted;
+    Parse(trial.get(), interrupted);
+    failed_ = Text(root.get(), "failed");
+    if (interrupted.valid()) {
+        failed_ = interrupted.revision;
+        Persist(committed_, {}, failed_);
+    }
+}
+
+bool BackendSelection::Parse(const cJSON* value, Plan& output) {
+    if (!cJSON_IsObject(value))
+        return false;
+    const auto version = cJSON_GetObjectItemCaseSensitive(value, "v");
+    const auto targets = cJSON_GetObjectItemCaseSensitive(value, "targets");
+    Plan plan;
+    plan.revision = Text(value, "revision");
+    plan.mode = Text(value, "mode");
+    if (!cJSON_IsNumber(version) || version->valuedouble != 1 || !Id(plan.revision) ||
+        (plan.mode != "computer" && plan.mode != "phone" && plan.mode != "auto") ||
+        !cJSON_IsArray(targets) || cJSON_GetArraySize(targets) < 1 ||
+        cJSON_GetArraySize(targets) > 2)
+        return false;
+    const cJSON* item;
+    cJSON_ArrayForEach (item, targets) {
+        BackendTarget target{Text(item, "id"),          Text(item, "kind"),
+                             Text(item, "url"),         Text(item, "token"),
+                             Text(item, "fallbackUrl"), Text(item, "remoteUrl")};
+        const auto wire_version = cJSON_GetObjectItemCaseSensitive(item, "version");
+        if (!Id(target.id) || (target.kind != "computer" && target.kind != "phone") ||
+            !Url(target.url) || target.token.size() != 64 ||
+            target.token.find_first_not_of("abcdef0123456789") != std::string::npos ||
+            !cJSON_IsNumber(wire_version) || wire_version->valuedouble != 1)
+            return false;
+        if (!target.fallback_url.empty()) {
+            if (!Url(target.fallback_url) || !target.fallback_url.starts_with("ws://") ||
+                !target.url.starts_with("ws://"))
+                return false;
+            const auto primary_end = target.url.find('/', 5);
+            const auto primary_authority = target.url.substr(5, primary_end - 5);
+            const auto primary_colon = primary_authority.find(':');
+            const auto fallback_end = target.fallback_url.find('/', 5);
+            const auto fallback_authority = target.fallback_url.substr(5, fallback_end - 5);
+            const auto fallback_colon = fallback_authority.find(':');
+            const auto primary_port = primary_colon == std::string::npos
+                                          ? "80"
+                                          : primary_authority.substr(primary_colon + 1);
+            const auto fallback_port = fallback_colon == std::string::npos
+                                           ? "80"
+                                           : fallback_authority.substr(fallback_colon + 1);
+            if (!primary_authority.substr(0, primary_colon).ends_with(".local") ||
+                !PrivateIp(fallback_authority.substr(0, fallback_colon)) ||
+                primary_port != fallback_port)
+                return false;
+        }
+        const auto remote = cJSON_GetObjectItemCaseSensitive(item, "remoteUrl");
+        if (remote && (!cJSON_IsString(remote) || !target.url.starts_with("ws://") ||
+                       !target.remote_url.starts_with("wss://") || !Url(target.remote_url)))
+            return false;
+        for (const auto& previous : plan.targets)
+            if (previous.id == target.id || previous.kind == target.kind)
+                return false;
+        plan.targets.push_back(std::move(target));
+    }
+    if (plan.mode == "auto") {
+        if (plan.targets.size() != 2)
+            return false;
+        if (plan.targets[0].kind != "computer")
+            std::swap(plan.targets[0], plan.targets[1]);
+    } else if (plan.targets.size() != 1 || plan.targets[0].kind != plan.mode)
+        return false;
+    output = std::move(plan);
+    return true;
+}
+
+std::string BackendSelection::Encode(const Plan& plan) {
+    if (!plan.valid())
+        return "";
+    Json root(cJSON_CreateObject(), cJSON_Delete);
+    cJSON_AddNumberToObject(root.get(), "v", 1);
+    cJSON_AddStringToObject(root.get(), "revision", plan.revision.c_str());
+    cJSON_AddStringToObject(root.get(), "mode", plan.mode.c_str());
+    auto targets = cJSON_AddArrayToObject(root.get(), "targets");
+    for (const auto& target : plan.targets) {
+        auto item = cJSON_CreateObject();
+        cJSON_AddStringToObject(item, "id", target.id.c_str());
+        cJSON_AddStringToObject(item, "kind", target.kind.c_str());
+        cJSON_AddStringToObject(item, "url", target.url.c_str());
+        cJSON_AddStringToObject(item, "token", target.token.c_str());
+        if (!target.fallback_url.empty())
+            cJSON_AddStringToObject(item, "fallbackUrl", target.fallback_url.c_str());
+        if (!target.remote_url.empty())
+            cJSON_AddStringToObject(item, "remoteUrl", target.remote_url.c_str());
+        cJSON_AddNumberToObject(item, "version", 1);
+        cJSON_AddItemToArray(targets, item);
+    }
+    return Dump(root.get());
+}
+
+bool BackendSelection::Persist(const Plan& committed, const Plan& trial,
+                               const std::string& failed) {
+    Json root(cJSON_CreateObject(), cJSON_Delete);
+    cJSON_AddStringToObject(root.get(), "plan", Encode(committed).c_str());
+    cJSON_AddStringToObject(root.get(), "trial", Encode(trial).c_str());
+    cJSON_AddStringToObject(root.get(), "failed", failed.c_str());
+    const auto saved = Dump(root.get());
+    if (saved.empty() || saved.size() > 3000)
+        return false;
+    nvs_handle_t handle;
+    if (nvs_open("douli_route", NVS_READWRITE, &handle) != ESP_OK)
+        return false;
+    auto error = nvs_set_str(handle, "state", saved.c_str());
+    if (error == ESP_OK)
+        error = nvs_commit(handle);
+    nvs_close(handle);
+    return error == ESP_OK;
+}
+
+bool BackendSelection::HasPlan() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return committed_.valid() || trial_.valid();
+}
+
+bool BackendSelection::Stage(const cJSON* value) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Plan next;
+    if (trial_.valid() || !Parse(value, next) || !Persist(committed_, next, ""))
+        return false;
+    trial_ = std::move(next);
+    failed_.clear();
+    cursor_ = 0;
+    return true;
+}
+
+BackendTarget BackendSelection::BeginAttempt() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto& plan = trial_.valid() ? trial_ : committed_;
+    active_ = plan.valid() ? plan.targets[cursor_ % plan.targets.size()] : BackendTarget{};
+    return active_;
+}
+
+bool BackendSelection::Connected() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (trial_.valid()) {
+        if (!Persist(trial_, {}, ""))
+            return false;
+        committed_ = std::move(trial_);
+        trial_ = {};
+    }
+    cursor_ = 0;  // The next new connection again prefers the computer.
+    return true;
+}
+
+void BackendSelection::Failed() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++cursor_;
+    if (trial_.valid() && cursor_ >= trial_.targets.size()) {
+        failed_ = trial_.revision;
+        trial_ = {};
+        cursor_ = 0;
+        Persist(committed_, {}, failed_);
+    }
+}
+
+cJSON* BackendSelection::Status() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto& plan = trial_.valid() ? trial_ : committed_;
+    auto root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "mode", plan.valid() ? plan.mode.c_str() : "computer");
+    cJSON_AddStringToObject(root, "revision", plan.revision.c_str());
+    cJSON_AddStringToObject(root, "targetId", active_.id.c_str());
+    cJSON_AddStringToObject(root, "phase",
+                            trial_.valid() ? "trial" : (plan.valid() ? "applied" : "legacy"));
+    cJSON_AddStringToObject(root, "failedRevision", failed_.c_str());
+    return root;
+}
