+    if (!connected && !active_backend_.fallback_url.empty()) {
+        CloseAudioChannel();
+        ESP_LOGI(TAG, "Trying the paired backend's saved LAN address");
+        connected = ConnectBackend(active_backend_.fallback_url);
+    }
+    if (!connected && !active_backend_.remote_url.empty()) {
+        CloseAudioChannel();
+        ESP_LOGI(TAG, "LAN unavailable; trying the paired backend's encrypted remote address");
+        connected = ConnectBackend(active_backend_.remote_url);
