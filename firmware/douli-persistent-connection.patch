+    cJSON_AddStringToObject(report, "action", "status");
+    cJSON_AddItemToObject(report, "backend", selection.Status());
+    auto text = cJSON_PrintUnformatted(report);
+    if (text) {
+        SendText(text);
+        cJSON_free(text);
+    }
+    cJSON_Delete(report);
+    return true;
