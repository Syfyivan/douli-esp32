+#pragma once
+
+#include <cJSON.h>
+#include <mutex>
+#include <string>
+#include <vector>
+
+struct BackendTarget {
+    std::string id;
+    std::string kind;
+    std::string url;
+    std::string token;
+    std::string fallback_url;
+    std::string remote_url;
+};
+
+// All endpoint credentials remain in NVS. Reports contain identity and outcome
+// only. The old committed plan survives an unsuccessful trial or power loss.
+class BackendSelection {
+public:
+    static BackendSelection& GetInstance();
+    bool HasPlan();
+    bool Stage(const cJSON* value);
+    BackendTarget BeginAttempt();
+    bool Connected();
+    void Failed();
+    cJSON* Status();
+
+private:
+    struct Plan {
+        std::string revision;
+        std::string mode;
+        std::vector<BackendTarget> targets;
+        bool valid() const { return !revision.empty(); }
+    };
+    BackendSelection();
+    static bool Parse(const cJSON* value, Plan& output);
+    static std::string Encode(const Plan& plan);
+    bool Persist(const Plan& committed, const Plan& trial, const std::string& failed);
+    std::mutex mutex_;
+    Plan committed_;
+    Plan trial_;
+    BackendTarget active_;
+    std::string failed_;
+    size_t cursor_ = 0;
+};
