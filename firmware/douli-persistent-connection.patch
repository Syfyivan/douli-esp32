+// Pairing credentials may only accompany HTTPS discovery at the already
+// provisioned WSS authority. Never send them to an HTTP or unrelated OTA URL.
+std::string SecureAuthority(const std::string& url, const std::string& scheme) {
+    if (!url.starts_with(scheme)) {
+        return "";
+    }
+    auto end = url.find('/', scheme.size());
+    auto authority = url.substr(scheme.size(),
+                                end == std::string::npos ? std::string::npos : end - scheme.size());
+    if (authority.find_first_not_of(
+            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-:") !=
+        std::string::npos) {
+        return "";
+    }
+    return authority;
+}
