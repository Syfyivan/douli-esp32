diff --git a/main/audio/wake_words/wake_word_speech_window.h b/main/audio/wake_words/wake_word_speech_window.h
new file mode 100644
index 0000000..cb777e9
--- /dev/null
+++ b/main/audio/wake_words/wake_word_speech_window.h
@@ -0,0 +1,63 @@
+#ifndef WAKE_WORD_SPEECH_WINDOW_H
+#define WAKE_WORD_SPEECH_WINDOW_H
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Owned by the detector feed task. VAD only aligns the decoder window; it
+// never gates audio. Keep 320 ms before speech to cover AFE VAD latency.
+class WakeWordSpeechWindow {
+public:
+    static constexpr size_t kPrerollSamples = 16000 * 320 / 1000;
+    static constexpr size_t kRearmSilenceSamples = 16000 * 480 / 1000;
+
+    void Reset() {
+        size_ = position_ = silence_samples_ = 0;
+        armed_ = true;
+    }
+
+    bool Observe(bool speech, size_t samples) {
+        if (samples == 0)
+            return false;
+        if (speech) {
+            silence_samples_ = 0;
+            const bool restart = armed_;
+            armed_ = false;
+            return restart;
+        }
+        silence_samples_ += std::min(samples, kRearmSilenceSamples - silence_samples_);
+        if (silence_samples_ == kRearmSilenceSamples)
+            armed_ = true;
+        return false;
+    }
+
+    void Remember(const int16_t* data, size_t samples) {
+        if (data == nullptr)
+            return;
+        for (size_t i = 0; i < samples; ++i) {
+            history_[position_] = data[i];
+            position_ = (position_ + 1) % kPrerollSamples;
+            size_ = std::min(size_ + 1, kPrerollSamples);
+        }
+    }
+
+    void CopyPreroll(std::vector<int16_t>& output) const {
+        output.clear();
+        output.reserve(size_);
+        const size_t start = (position_ + kPrerollSamples - size_) % kPrerollSamples;
+        for (size_t i = 0; i < size_; ++i)
+            output.push_back(history_[(start + i) % kPrerollSamples]);
+    }
+
+private:
+    std::array<int16_t, kPrerollSamples> history_{};
+    size_t size_ = 0;
+    size_t position_ = 0;
+    size_t silence_samples_ = 0;
+    bool armed_ = true;
+};
+
+#endif
