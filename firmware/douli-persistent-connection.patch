+
+void Application::MaintainPersistentConnection() {
+    if (background_connecting_ || !protocol_ready_ || !network_connected_ || !protocol_ ||
+        !protocol_->SupportsPersistentConnection() || GetDeviceState() != kDeviceStateIdle ||
+        (!backend_reconnect_requested_ && protocol_->IsAudioChannelOpened()))
+        return;
+    const auto now = esp_timer_get_time() / 1000;
+    if (now < next_connection_attempt_ms_)
+        return;
+    background_connecting_ = true;
+    Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    const bool switching_backend = backend_reconnect_requested_;
+    backend_reconnect_requested_ = false;
+    // Connection and hello can block on an unavailable server. Keep them off
+    // the main/audio tasks; protocol teardown is deferred until this completes.
+    const auto created = xTaskCreate(
+        [](void* arg) {
+            auto app = static_cast<Application*>(arg);
+            app->protocol_->CloseAudioChannel();
+            const bool connected = app->protocol_->OpenAudioChannel();
+            app->Schedule([app, connected]() {
+                app->background_connecting_ = false;
+                if (app->pending_reboot_) {
+                    app->pending_reboot_ = false;
+                    app->Reboot();
+                    return;
+                }
+                if (app->pending_protocol_reset_) {
+                    app->pending_protocol_reset_ = false;
+                    app->ResetProtocol();
+                    return;
+                }
+                if (connected && app->network_connected_) {
+                    app->connection_retry_seconds_ = 5;
+                    app->next_connection_attempt_ms_ = 0;
+                    ESP_LOGI(TAG, "Douli persistent connection ready");
+                    if (!app->pending_connected_wake_word_.empty()) {
+                        auto wake_word = std::move(app->pending_connected_wake_word_);
+                        app->pending_connected_wake_word_.clear();
+                        app->pending_connected_listening_ = false;
+                        app->BeginWakeWordInvoke(wake_word);
+                    } else if (app->pending_connected_listening_) {
+                        app->pending_connected_listening_ = false;
+                        app->SetListeningMode(app->pending_connected_mode_);
+                    } else {
+                        app->EnterStandby();
+                    }
+                } else {
+                    if (connected)
+                        app->protocol_->CloseAudioChannel();
+                    app->pending_connected_wake_word_.clear();
+                    app->pending_connected_listening_ = false;
+                    app->audio_service_.EnableWakeWordDetection(true);
+                    app->next_connection_attempt_ms_ =
+                        esp_timer_get_time() / 1000 + app->connection_retry_seconds_ * 1000;
+                    app->connection_retry_seconds_ =
+                        std::min(app->connection_retry_seconds_ * 2, 60);
+                }
+            });
+            vTaskDelete(nullptr);
+        },
+        "douli_connect", 8192, this, 3, nullptr);
+    if (created != pdPASS) {
+        background_connecting_ = false;
+        backend_reconnect_requested_ = switching_backend;
+        next_connection_attempt_ms_ = now + 5000;
+    }
+}
